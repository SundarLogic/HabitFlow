# HabitFlow backend environment. Copy to backend/.env and fill in real values.
# Every variable is validated at startup by src/config/env.js; the process exits with a
# clear message if anything is missing or malformed. Never commit backend/.env.

# Runtime mode: development | test | production (default: development).
# npm test forces NODE_ENV=test.
NODE_ENV=development

# HTTP port the API listens on (default: 3000).
PORT=3000

# --- Database (development / production) ---
# EITHER a full connection URL ...
# DATABASE_URL=postgres://habitflow:change-me@localhost:5432/habitflow_dev
# ... OR all five parts below (used when DATABASE_URL is empty).
# DB_PORT must match POSTGRES_PORT in the root .env (docker compose host port).
DB_HOST=localhost
DB_PORT=5432
DB_USER=habitflow
DB_PASSWORD=change-me
DB_NAME=habitflow_dev

# --- Database (tests) ---
# Required when NODE_ENV=test. The database name MUST end with "_test":
# tests truncate every table between runs.
TEST_DATABASE_URL=postgres://habitflow:change-me@localhost:5432/habitflow_test

# Comma-separated browser origins allowed by CORS (with credentials).
# Each must be scheme://host[:port], with no path or trailing slash.
CLIENT_ORIGINS=http://localhost:5173

# Session lifetime in days, 1-365 (default: 30).
SESSION_TTL_DAYS=30

# Send cookies with the Secure flag: true | false.
# Default: true in production, false otherwise. Must be true in production.
COOKIE_SECURE=false

# Send habit reminders: true | false (default: true). The scheduler runs every minute inside
# `npm run dev` / `npm start`, never during tests. Set to false to silence it locally.
REMINDERS_ENABLED=true

# pino log level: fatal | error | warn | info | debug | trace | silent (default: info).
# Tests default to silent unless LOG_LEVEL is set in the shell.
LOG_LEVEL=info

# Requests allowed per 15 minutes: everything under /api per IP (default 300), and login +
# signup per IP + email (default 10). Only raise them for load tests or E2E runs.
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Number of reverse proxies (load balancer, nginx...) in front of the API, 0-10 (default: 0).
# Set it when deploying behind a proxy so rate limits and logs see the real client IP.
# Leave 0 when clients connect directly: then X-Forwarded-For is ignored and can't be spoofed.
TRUST_PROXY=0
