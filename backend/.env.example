# Backend env. Copy to backend/.env (and backend/.env.test for tests).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (matches root .env used by docker compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=habitflow
DB_PASSWORD=change-me
DB_NAME=habitflow_dev

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Session lifetime
SESSION_TTL_DAYS=30
